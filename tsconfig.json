{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "integrations/**/*.ts", "scripts/**/*.ts", "prototypes/**/*.ts", "web/**/*.js"]
}
